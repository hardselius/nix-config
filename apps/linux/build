#!/bin/sh -e

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

: "${SYSTEM_TYPE:?must be set — run via 'nix run .#build', not directly}"

# --desktop selects the <system>-desktop home configuration.
TARGET="$SYSTEM_TYPE"
if [ "$1" = "--desktop" ]; then
	TARGET="$SYSTEM_TYPE-desktop"
	shift
fi

printf '%b\n' "${YELLOW}Building home configuration $TARGET...${NC}"
home-manager build --flake ".#$TARGET" "$@"

printf '%b\n' "${YELLOW}Cleaning up...${NC}"
unlink ./result

printf '%b\n' "${GREEN}Build complete!${NC}"
