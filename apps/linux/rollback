#!/bin/sh -e

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

: "${SYSTEM_TYPE:?must be set — run via 'nix run .#rollback', not directly}"

printf '%b\n' "${YELLOW}Available generations:${NC}"
home-manager generations

printf '%b\n' "${YELLOW}Enter the generation number for rollback:${NC}"
read -r GEN_NUM

# Lines look like: 2026-01-01 12:00 : id 42 -> /nix/store/...-home-manager-generation
GEN_PATH=$(home-manager generations | awk -v id="$GEN_NUM" '$5 == id { print $7 }')

if [ -z "$GEN_PATH" ]; then
	printf '%b\n' "${RED}No generation '$GEN_NUM'. Aborting rollback.${NC}"
	exit 1
fi

printf '%b\n' "${YELLOW}Rolling back to generation $GEN_NUM...${NC}"
"$GEN_PATH/activate"

printf '%b\n' "${GREEN}Rollback to generation $GEN_NUM complete!${NC}"
